# ---- Zdroje dat ----
# Travelpayouts: registrace na travelpayouts.com, token v Profil → API token
TRAVELPAYOUTS_TOKEN=
# Marker (affiliate ID) ze stejného účtu — bez něj nejsou provize
TRAVELPAYOUTS_MARKER=
# Ryanair public API žádný token nepotřebuje

# ---- Verifikace ceny (nepovinné, 4. milník) ----
# SerpApi free tarif = 250 dotazů/měsíc
SERPAPI_KEY=

# ---- Databáze ----
# Lokálně nech prázdné → použije se SQLite v ./flight_deals.db
# V GitHub Actions nastav Neon/Supabase connection string
DATABASE_URL=
# Cesta ke SQLite souboru, když DATABASE_URL není nastavené
SQLITE_PATH=flight_deals.db

# ---- Notifikace ----
# Telegram: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Brevo (7. milník, e-mailový digest)
BREVO_API_KEY=
BREVO_LIST_ID=

# ---- Web ----
SITE_BASE_URL=https://nestuj-cestuj.cz

# ---- Ladění prahů ----
# Minimum pozorování na trasu, než se smí poslat alert
MIN_HISTORY_OBSERVATIONS=30
# Pokles proti mediánu, od kterého je to zajímavé (0.40 = o 40 % níž)
DEAL_DROP_THRESHOLD=0.40
# Pokles, od kterého to označíme za pravděpodobnou chybu v ceně
ERROR_FARE_DROP_THRESHOLD=0.60
